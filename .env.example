# =============================================================================
# Credent API Environment Configuration
#
# Copy this file to `.env` and replace the placeholder values with your own.
# SQLite fallback will be used automatically if Supabase is not configured.
# =============================================================================

# Groq
GROQ_API_KEY="your-groq-api-key"

# Supabase (Database + Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"

# Supabase Storage bucket name (create this bucket in your Supabase dashboard)
# Dashboard → Storage → New Bucket → Name: "credent-documents" → Private
SUPABASE_STORAGE_BUCKET="credent-documents"

# Task Queue Configuration (ASE-52)
# Set to "false" for local development (uses FastAPI BackgroundTasks, no Redis needed)
# Set to "true" in production (uses Celery + Redis, requires CELERY_BROKER_URL)
USE_CELERY="false"

# Required only when USE_CELERY=true
# CELERY_BROKER_URL="redis://localhost:6379/0"

# Temp file cleanup — files older than this many seconds are purged on startup
TEMP_FILE_CLEANUP_MAX_AGE_SECONDS=3600

# LLM model selection (must be valid Groq model IDs)
PRIMARY_LLM_MODEL="openai/gpt-oss-20b"
FALLBACK_LLM_MODEL_1="qwen/qwen3.6-27b"
FALLBACK_LLM_MODEL_2="openai/gpt-oss-120b"

# Max completion tokens requested per LLM call.
# IMPORTANT: Groq counts this value against your tokens-per-minute (TPM) quota
# BEFORE running the request. If it exceeds your TPM limit, every call fails with
# HTTP 413 and the pipeline silently falls back to placeholder values
# ("Unknown Entity", score 65). The free tier is 8000 TPM, so keep this well
# under that. The CAM generator has the largest prompt (~4600 tokens, it embeds
# the full CAMDocument JSON schema), so this value plus that prompt must stay
# below the TPM limit. 3000 is verified working on gpt-oss-20b/120b and
# qwen3.6-27b. Raise it only after upgrading your Groq plan.
LLM_MAX_TOKENS=3000

# [P0-5] Deployment environment. Controls the database policy.
#   development (default) - SQLite fallback permitted
#   test                  - SQLite permitted
#   production            - SUPABASE_URL/SUPABASE_KEY REQUIRED; the app
#                           refuses to start without them, because SQLite in
#                           a container writes lending records to ephemeral
#                           storage that is lost on restart.
APP_ENV="development"

# [P1-3] Per-tenant rate limits. Keyed on the authenticated organization so
# one tenant cannot exhaust shared LLM quota or ingestion capacity.
# Limits are enforced PER API PROCESS (no Redis in this deployment); set
# RATE_LIMIT_WORKERS to the number of API workers so the configured limits
# are divided across them and the effective ceiling stays correct.
RATE_LIMIT_WORKERS=1
RATE_LIMIT_AUTH=10        # login attempts per minute, keyed by client IP
RATE_LIMIT_READ=300       # authenticated reads per minute per tenant
RATE_LIMIT_WRITE=60       # cheap state changes per minute per tenant
RATE_LIMIT_AI=20          # document ingestion / CAM generation per HOUR per tenant
RATE_LIMIT_ADMIN=120      # platform admin operations per minute

# =============================================================================
# IDENTITY STORE  (users, sessions, MFA, lockout, tenant memberships)
# =============================================================================
# Authentication previously used SQLite unconditionally. On a container host
# with an ephemeral filesystem (Render, Fly, most PaaS) that file is recreated
# empty on every deploy, so all accounts vanished and login returned 401 on the
# deployed API while working fine locally.
#
# Set this to your Supabase Postgres connection string and identity survives
# restarts. Find it in Supabase: Project Settings -> Database -> Connection
# string -> URI. Leave it unset for local development to keep using SQLite.
#
# AUTH_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Only postgresql:// , postgres:// and postgresql+psycopg2:// are accepted.
# DATABASE_URL and SUPABASE_DB_URL are also read, but DATABASE_URL is a name
# other tooling claims too: a value left over from an unrelated service (for
# example "sqlite+aiosqlite:///./other.db") is ignored with a log line rather
# than crashing startup. Prefer AUTH_DATABASE_URL so there is no ambiguity.

# ORDER OF OPERATIONS - read before setting APP_ENV=production:
#   APP_ENV=production refuses every SQLite connection (see app/core/db_policy.py).
#   Because the identity layer goes through that same guard, setting
#   APP_ENV=production WITHOUT AUTH_DATABASE_URL turns login into a 500 rather
#   than a 401. Configure AUTH_DATABASE_URL first, confirm login works, then
#   switch APP_ENV to production.
