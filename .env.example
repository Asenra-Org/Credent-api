# =============================================================================
# Credent API Environment Configuration
#
# Copy this file to `.env` and replace the placeholder values with your own.
# SQLite fallback will be used automatically if Supabase is not configured.
# =============================================================================

# Application Release Identity (Mandatory Fail-Closed)
APP_RELEASE_TAG="v1.0.0"

# Groq
GROQ_API_KEY="your-groq-api-key"

# PostgreSQL / Supabase Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/credent"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"