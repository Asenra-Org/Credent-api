# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Testing
.coverage
htmlcov/
.pytest_cache/

# Models & Data (large files)
*.h5
*.pkl
*.joblib
data/raw/
data/processed/
uploads/

# Misc
*.bak
*.tmp

# Local Databases
*.db
*.sqlite

# Internal AI Memory
.ai/

# [P1-2] Local database artifacts. `*.db` already matched credent.db, but the
# file was committed before that rule existed, so git kept tracking it and a
# 3 MB binary carrying test users and appraisal rows shipped with every clone.
# It is untracked now; init_db() recreates the schema on first run.
app/database/*.db
app/database/*.sqlite
app/database/*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# [P1-2] Uploaded borrower documents and local document store must never be committed.
temp_uploads/
document_store/
